{
  "outputDirectory": "build",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/how-it-works",
      "destination": "/#how-it-works",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_app/immutable/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.svg|favicon.png|apple-touch-icon.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
